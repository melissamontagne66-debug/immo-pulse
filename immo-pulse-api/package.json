{
  "name": "immo-pulse-api",
  "version": "1.0.0",
  "description": "API Immo Pulse pour sauvegarder les données des conseillers",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create immo-pulse-db",
    "db:schema": "wrangler d1 execute immo-pulse-db --file=schema.sql",
    "db:migrate": "wrangler d1 migrations apply immo-pulse-db"
  },
  "devDependencies": {
    "wrangler": "^3.0.0",
    "@cloudflare/workers-types": "^4.20231218.0"
  }
}
